    def on_fixture_font_changed(self, event=None):
        """æ²»å…·å­—é?å¤§å??³æ??´æ–°ï¼ˆå??´æ–°é¡¯ç¤ºï¼Œä??ªå?ä¿å?ï¼?""
        try:
            new_size = self.vars["Fixture_Font_Size"].get()
            if new_size.isdigit():
                size = int(new_size)
                if 8 <= size <= 24:
                    # ?ªæ›´?°UIé¡¯ç¤ºï¼Œä??ªå?ä¿å??°æ?æ¡?
                    print(f"[DEBUG] æ²»å…·å­—é?å¤§å?å·²è??´ç‚º {size}ï¼Œè?é»æ?ä¿å??‰é?ä»¥å„²å­˜è???)

                    # ?šçŸ¥?¶å…·?§åˆ¶?é¢?´æ–°å­—é?é¡¯ç¤º
                    self.apply_fixture_font_changes(size)
        except Exception as e:
            print(f"?´æ–°æ²»å…·å­—é??‚ç™¼?ŸéŒ¯èª? {e}")

    def on_title_changed(self, *args):
        """è¦–ç?æ¨™é?è®Šæ›´?‚ç??•ç?ï¼Œé??¶æ?å¤?0?‹å???""
        try:
            current_title = self.vars["Window_Title"].get()
            char_count = len(current_title)
            
            # ?´æ–°å­—å?è¨ˆæ•¸é¡¯ç¤º
            if hasattr(self, 'title_count_label'):
                color = 'red' if char_count > 50 else 'gray'
                self.title_count_label.config(text=f"({char_count}/50)", foreground=color)
            
            # å¦‚æ?è¶…é?50?‹å??ƒï??ªæ–·ä¸¦é¡¯ç¤ºè­¦??
            if char_count > 50:
                truncated_title = current_title[:50]
                self.vars["Window_Title"].set(truncated_title)
                print(f"[WARNING] è¦–ç?æ¨™é?å·²æˆª?·è‡³50?‹å??? {truncated_title}")
                
                # é¡¯ç¤º?ç¤ºè¨Šæ¯
                print("[NOTIFICATION] è¦–ç?æ¨™é?å·²é??¶ç‚º50?‹å???)
                    
        except Exception as e:
            print(f"[ERROR] ?•ç?è¦–ç?æ¨™é?è®Šæ›´?‚ç™¼?ŸéŒ¯èª? {e}")

    def on_separator_changed(self, event=None):
        """?‡ä»¤?“é?ç¬¦è??¸æ?è®Šæ›´?‚ç??•ç?"""
        try:
            new_separator = self.vars["DUT_Command_Separator"].get()
            if new_separator:  # ç¢ºä?ä¸ç‚ºç©?
                print(f"[DEBUG] ?“é?ç¬¦è?è®Šæ›´?? '{new_separator}'")
                
                # ç«‹å³?´æ–°è¨­å?æª?
                settings = load_setup()
                if 'DUT_Control' not in settings:
                    settings['DUT_Control'] = {}
                
                # ä¿å??¶å??¸æ??„é??”ç¬¦??
                settings['DUT_Control']['Command_Separator'] = new_separator
                
                # ç¢ºä??ªè??“é?ç¬¦è??—è¡¨å­˜åœ¨
                if 'Custom_Separators' not in settings['DUT_Control']:
                    settings['DUT_Control']['Custom_Separators'] = ["|", "||", "==>"]
                
                # å¦‚æ??°é¸?‡ç?ç¬¦è?ä¸åœ¨?ªè??—è¡¨ä¸­ï?æ·»å?å®?
                custom_separators = settings['DUT_Control']['Custom_Separators']
                if new_separator not in custom_separators:
                    custom_separators.append(new_separator)
                    settings['DUT_Control']['Custom_Separators'] = custom_separators
                    print(f"[DEBUG] å·²å??°é¸?‡ç??“é?ç¬¦è? '{new_separator}' æ·»å??°è‡ªè¨‚å?è¡?)
                
                # ä¿å?è¨­å?
                save_setup(settings)
                print(f"[INFO] ?‡ä»¤?“é?ç¬¦è?å·²ä?å­˜åˆ° setup.json: '{new_separator}'")
                
                # ?šçŸ¥?¶ä??ƒä»¶?´æ–°
                self.apply_separator_changes_immediately()
                
        except Exception as e:
            print(f"?´æ–°?‡ä»¤?“é?ç¬¦è??‚ç™¼?ŸéŒ¯èª? {e}")
            import traceback
            traceback.print_exc()

    def add_custom_separator(self):
        """?°å??ªè??“é?ç¬¦è?"""
        try:
            new_separator = self.custom_separator_entry.get().strip()
            if not new_separator:
                messagebox.showwarning("è­¦å?", "è«‹è¼¸?¥é??”ç¬¦??)
                return
            
            # è®€?–ç•¶?è¨­å®?
            settings = load_setup()
            if 'DUT_Control' not in settings:
                settings['DUT_Control'] = {}
            if 'Custom_Separators' not in settings['DUT_Control']:
                settings['DUT_Control']['Custom_Separators'] = ["|", "||", "==>"]
            
            custom_separators = settings['DUT_Control']['Custom_Separators']
            
            # æª¢æŸ¥?¯å¦å·²å???
            if new_separator in custom_separators:
                messagebox.showwarning("è­¦å?", "è©²é??”ç¬¦?Ÿå·²å­˜åœ¨")
                return
            
            # æ·»å??°å?è¡?
            custom_separators.append(new_separator)
            settings['DUT_Control']['Custom_Separators'] = custom_separators
            
            # ä¿å?è¨­å?
            save_setup(settings)
            
            # ?´æ–°ä¸‹æ??¸å–®
            self.update_separator_combo()
            
            # æ¸…ç©ºè¼¸å…¥æ¡?
            self.custom_separator_entry.delete(0, tk.END)
            
            print(f"[INFO] å·²æ–°å¢è‡ªè¨‚é??”ç¬¦?? {new_separator}")
            messagebox.showinfo("?å?", f"å·²æ–°å¢é??”ç¬¦?? {new_separator}")
            
        except Exception as e:
            print(f"?°å??ªè??“é?ç¬¦è??‚ç™¼?ŸéŒ¯èª? {e}")
            messagebox.showerror("?¯èª¤", f"?°å??“é?ç¬¦è?å¤±æ?: {e}")

    def remove_custom_separator(self):
        """ç§»é™¤?¸ä¸­?„è‡ªè¨‚é??”ç¬¦??""
        try:
            current_separator = self.vars["DUT_Command_Separator"].get()
            
            # è®€?–ç•¶?è¨­å®?
            settings = load_setup()
            if 'DUT_Control' not in settings:
                settings['DUT_Control'] = {}
            if 'Custom_Separators' not in settings['DUT_Control']:
                settings['DUT_Control']['Custom_Separators'] = ["|", "||", "==>"]
            
            custom_separators = settings['DUT_Control']['Custom_Separators']
            
            # æª¢æŸ¥?¯å¦?ºå…§å»ºç¬¦??
            built_in_separators = ["|", "||", "==>"]
            if current_separator in built_in_separators:
                messagebox.showwarning("è­¦å?", "?¡æ?ç§»é™¤?§å»º?„é??”ç¬¦??)
                return
            
            # è©¢å?ç¢ºè?
            result = messagebox.askyesno("ç¢ºè?ç§»é™¤", f"ç¢ºå?è¦ç§»?¤é??”ç¬¦??'{current_separator}' ?ï?")
            if not result:
                return
            
            # å¾å?è¡¨ä¸­ç§»é™¤
            if current_separator in custom_separators:
                custom_separators.remove(current_separator)
                settings['DUT_Control']['Custom_Separators'] = custom_separators
                
                # ä¿å?è¨­å?
                save_setup(settings)
                
                # ?ç½®?ºé?è¨­å€?
                self.vars["DUT_Command_Separator"].set("|")
                
                # ?´æ–°ä¸‹æ??¸å–®
                self.update_separator_combo()
                
                print(f"[INFO] å·²ç§»?¤é??”ç¬¦?? {current_separator}")
                messagebox.showinfo("?å?", f"å·²ç§»?¤é??”ç¬¦?? {current_separator}")
            else:
                messagebox.showwarning("è­¦å?", "?¾ä??°è?ç§»é™¤?„é??”ç¬¦??)
                
        except Exception as e:
            print(f"ç§»é™¤?ªè??“é?ç¬¦è??‚ç™¼?ŸéŒ¯èª? {e}")
            messagebox.showerror("?¯èª¤", f"ç§»é™¤?“é?ç¬¦è?å¤±æ?: {e}")

    def update_separator_combo(self):
