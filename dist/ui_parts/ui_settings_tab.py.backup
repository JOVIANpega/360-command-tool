        # ?´æ–°?€??UI ?§ä»¶?„å€?
        self.update_ui_from_settings()
        
        print("[DEBUG] è¨­å??†é?å·²æ?æ´»ä¸¦?´æ–°")

    def sync_current_window_size(self):
        """?Œæ­¥?¶å?è¦–ç?å¤§å??°è¨­å®šæ?ä½?""
        try:
            # ?²å?ä¸»è?çª?
            root = self.winfo_toplevel()
            if root and hasattr(root, 'winfo_exists') and root.winfo_exists():
                width = root.winfo_width()
                height = root.winfo_height()

                # ?´æ–°è¨­å?æ¬„ä?
                self.vars["Window_Width"].set(str(width))
                self.vars["Window_Height"].set(str(height))
                print(f"[DEBUG] å·²å?æ­¥ç•¶?è?çª—å¤§å°? {width}x{height}")
        except Exception as e:
            print(f"[ERROR] ?Œæ­¥è¦–ç?å¤§å?å¤±æ?: {e}")

    def start_window_size_sync(self):
        """?Ÿå?å®šæ??Œæ­¥è¦–ç?å¤§å?"""
        def update_window_size():
            try:
                # ?²å?ä¸»è?çª?
                root = self.winfo_toplevel()
                if root and hasattr(root, 'winfo_exists') and root.winfo_exists():
                    width = root.winfo_width()
                    height = root.winfo_height()

                    # ?ªæ??¶å€¼ç?æ­?”¹è®Šæ??æ›´?°ï??¿å??¡é?å¾ªç’°
                    current_width = self.vars["Window_Width"].get()
                    current_height = self.vars["Window_Height"].get()

                    if current_width != str(width) or current_height != str(height):
                        self.vars["Window_Width"].set(str(width))
                        self.vars["Window_Height"].set(str(height))

                # æ¯ç??´æ–°ä¸€æ¬?
                self.after(1000, update_window_size)
            except Exception as e:
                # ?œé??•ç??¯èª¤ï¼Œé¿?å¹²?¾ç”¨?¶æ?ä½?
                self.after(1000, update_window_size)

        # ?Ÿå?å®šæ??´æ–°
        self.after(1000, update_window_size)

    def update_ui_from_settings(self):
        """å¾è¨­å®šæ›´??UI ?§ä»¶?„å€?""
        try:
            # ?´æ–°?ºæœ¬è¨­å? - ?ˆæœ¬?Ÿç›´?¥å?setup_dataè®€??
            current_version = self.setup_data.get("version", "1.6.2.0")
            self.vars["version"].set(current_version)
            print(f"[DEBUG] è¨­å??é¢?ˆæœ¬?Ÿæ›´?°ç‚º: {current_version}")
            window_title = self.setup_data.get("Window_Title", "?‡ä»¤??)
            self.vars["Window_Title"].set(window_title)
            # ?´æ–°å­—å?è¨ˆæ•¸é¡¯ç¤º
            if hasattr(self, 'title_count_label'):
                char_count = len(window_title)
                color = 'red' if char_count > 50 else 'gray'
                self.title_count_label.config(text=f"({char_count}/50)", foreground=color)
            self.vars["Window_Width"].set(self.setup_data.get("Window_Width", "1536"))
            self.vars["Window_Height"].set(self.setup_data.get("Window_Height", "793"))
            
            # ?´æ–°æ¨™ç±¤?å?ç¨?
            tab_names = self.setup_data.get('tab_names', {})
            for i in range(4):
                tab_key = f'tab{i}'
                if f"tab_names_{tab_key}" in self.vars:
                    default_names = ['DUT ?§åˆ¶', 'æ²»å…·?§åˆ¶', 'ä½¿ç”¨èªªæ?', 'è¨­å?']
                    self.vars[f"tab_names_{tab_key}"].set(tab_names.get(tab_key, default_names[i]))
            
            # ?´æ–° DUT ?§åˆ¶è¨­å?
            dut_settings = self.setup_data.get('DUT_Control', {})
            # ç§»é™¤å·²åˆª?¤ç?æ¬„ä?è¨­å?
            # self.vars["DUT_Serial_COM_Port"].set(dut_settings.get("Serial_COM_Port", "COM5"))
            # self.vars["DUT_Command_Timeout_Seconds"].set(dut_settings.get("Command_Timeout_Seconds", "30"))
            # self.vars["DUT_Command_End_String"].set(dut_settings.get("Command_End_String", "root"))
            self.vars["DUT_Command_Separator"].set(dut_settings.get("Command_Separator", "|"))
            self.vars["DUT_Default_IP_Address"].set(dut_settings.get("Default_IP_Address", "192.168.11.143"))
            # å­—é?è¨­å?å·²ç§»?³DUT?§åˆ¶æ¨™ç±¤?ï?æ­¤è?ä¸å??•ç?
            self.vars["DUT_Pane_Sash_Position"].set(dut_settings.get("Pane_Sash_Position", "633"))
            self.vars["DUT_Auto_Execute"].set(dut_settings.get("Auto_Execute", False))
            self.vars["DUT_Command_File_Path"].set(dut_settings.get("Command_File_Path", ""))
            
            # æ³¨æ?ï¼šæ²»?·æ§?¶è¨­å®šå·²ç§»å??³æ²»?·æ§?¶TABä¸­ï??™è£¡ä¸å??•ç?
            
            # ?´æ–° UI è¨­å?
            ui_settings = self.setup_data.get('UI_Settings', {})
            self.vars["UI_ToolTip_Enabled"].set(ui_settings.get("ToolTip_Enabled", True))
            
        except Exception as e:
            print(f"[ERROR] ?´æ–° UI è¨­å??‚ç™¼?ŸéŒ¯èª? {e}")

    def process_ip_history_save(self):
        """?•ç?IPæ­·å²è¨˜é??„ä?å­˜ï??åˆ¶5ç­†ã€å»?ã€ç½®?‚ï?"""
        try:
            current_ip = self.vars["DUT_Default_IP_Address"].get().strip()
            if not current_ip:
                print("[DEBUG] IP?°å??ºç©ºï¼Œè·³?IPæ­·å²?•ç?")
                return
            
            # ç°¡å–®?„IPv4?¼å?é©—è?
            ip_pattern = r'^(\d{1,3}\.){3}\d{1,3}$'
            if not re.match(ip_pattern, current_ip):
                print(f"[WARNING] IP?°å??¼å??¯èƒ½ä¸æ­£ç¢? {current_ip}ï¼Œä?ä»ç„¶ä¿å?")
                # ä¸é˜»æ­¢ä?å­˜ï??ªæ˜¯è¨˜é?è­¦å?
            else:
                # æª¢æŸ¥æ¯å€‹æ•¸å­—æ˜¯?¦åœ¨0-255ç¯„å???
                parts = current_ip.split('.')
                for part in parts:
                    if int(part) > 255:
                        print(f"[WARNING] IP?°å?ç¯„å??¯èƒ½ä¸æ­£ç¢? {current_ip}ï¼Œä?ä»ç„¶ä¿å?")
                        break
            
            # è¼‰å…¥?¶å?è¨­å?
            setup = load_setup()
            
            # è®€?–ç¾?‰IPæ­·å²ï¼ˆå„ª?ˆé?å±¤ï?
            ip_history = setup.get('IP_History')
            if ip_history is None:
                ip_history = setup.get('DUT_Control', {}).get('IP_History', [])
            
            # ?»é?ä¸¦ç½®?‚ç•¶?IP
            if current_ip in ip_history:
                ip_history.remove(current_ip)
                print(f"[DEBUG] IP {current_ip} å·²å??¨æ–¼æ­·å²ä¸­ï?ç§»è‡³?‚éƒ¨")
            else:
                print(f"[DEBUG] ?°å?IP {current_ip} ?°æ­·?²è???)
            
            ip_history.insert(0, current_ip)
            
            # ?åˆ¶?€å¤?ç­?
            if len(ip_history) > 5:
                removed_ips = ip_history[5:]
                ip_history = ip_history[:5]
                print(f"[INFO] IPæ­·å²è¨˜é??åˆ¶??ç­†ï?å·²ç§»?? {removed_ips}")
                
                # ?¯é¸ï¼šé¡¯ç¤ºæ?ç¤ºçµ¦?¨æˆ¶
                try:
                    from tkinter import messagebox
                    messagebox.showinfo("IPæ­·å²è¨˜é?", 
                                      f"IPæ­·å²è¨˜é?å·²é??¶ç‚º?€å¤?ç­†\nå·²ç§»?¤è??Šç?è¨˜é?: {', '.join(removed_ips)}")
                except:
                    pass
            
            # å¯«å??‚å±¤?ŒDUT_Controlï¼ˆç›¸å®¹æ€§ï?
            setup['IP_History'] = ip_history
            if 'DUT_Control' not in setup:
                setup['DUT_Control'] = {}
            setup['DUT_Control']['IP_History'] = ip_history
            setup['DUT_Control']['Default_IP_Address'] = current_ip
            
            # ä¿å??°æ?æ¡?
            save_setup(setup, manual_save=True)
            
            print(f"[INFO] IPæ­·å²å·²ä?å­˜æ??? {ip_history}")
            print(f"[INFO] ?è¨­IPå·²è¨­å®šç‚º: {current_ip}")
            
        except Exception as e:
            print(f"[ERROR] ?•ç?IPæ­·å²ä¿å??‚ç™¼?ŸéŒ¯èª? {e}")
            import traceback
            traceback.print_exc()
            try:
                from tkinter import messagebox
                messagebox.showerror("?¯èª¤", f"ä¿å?IPè¨­å??‚ç™¼?ŸéŒ¯èª? {str(e)}")
            except:
                pass

    def refresh_all_ip_dropdowns(self):
        """?·æ–°?€?‰é??¢ç?IPä¸‹æ?æ¸…å–®"""
        try:
            # ?æ–°è¼‰å…¥è¨­å??²å??€?°IPæ­·å²
            updated_setup = load_setup()
            ip_history = updated_setup.get('IP_History', [])
            
            # ?´æ–°?¬é??¢ç?IPä¸‹æ?
            if hasattr(self, 'ip_combobox'):
                self.ip_combobox['values'] = ip_history
                print(f"[DEBUG] è¨­å??IPä¸‹æ?å·²æ›´?? {ip_history}")
            
            # ?¾åˆ°ä¸»è?çª—ä¸¦?·æ–°DUT?§åˆ¶?ç?IPä¸‹æ?
            root = self.parent
            while root and not hasattr(root, 'dut_ui'):
                root = getattr(root, 'master', None) or getattr(root, 'parent', None)
            
            if root and hasattr(root, 'dut_ui'):
                try:
                    if hasattr(root.dut_ui, 'components') and hasattr(root.dut_ui.components, 'load_ip_history'):
                        root.dut_ui.components.load_ip_history()
                        print("[DEBUG] DUT?§åˆ¶?IPä¸‹æ?å·²åˆ·??)
                except Exception as e:
                    print(f"[WARNING] ?·æ–°DUT?§åˆ¶?IPä¸‹æ?å¤±æ?: {e}")
            
            print("[DEBUG] ?€?‰IPä¸‹æ?æ¸…å–®?·æ–°å®Œæ?")
            
        except Exception as e:
            print(f"[ERROR] ?·æ–°IPä¸‹æ?æ¸…å–®?‚ç™¼?ŸéŒ¯èª? {e}")
            import traceback
            traceback.print_exc()













 
